{
  "expo": {
    "name": "ARTPICK",
    "slug": "artpick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f6f2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taeyunlab.artpick",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "작품 등록 및 창작 일지 작성을 위해 사진 라이브러리 접근 권한이 필요합니다.",
        "NSCameraUsageDescription": "작품 및 작업실 현장 촬영을 위해 카메라 접근 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f7f6f2"
      },
      "package": "com.taeyunlab.artpick"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
